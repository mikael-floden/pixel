  --ink: #23211d;
  --muted: #736d63;
  --border: #e1dacd;
  --border-strong: #cdc5b6;
  --accent: #d97757;
  --accent-soft: #fbded4;
  --accent-ink: #b15005;
  --good: #497849;
  --good-soft: #deecde;
  --bad: #b3453a;
  --bad-soft: #f8dedb;
  --star: #d9a13b;
  --checker-a: #f1ebe1;
  --checker-b: #e4ddd1;
  --shadow: 0 1px 2px rgba(40, 35, 25, 0.06), 0 4px 16px rgba(40, 35, 25, 0.05);
