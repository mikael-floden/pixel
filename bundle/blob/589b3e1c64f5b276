  // took that back).
  float rawBand = distBand + elevBand;           // UNCLAMPED: elevBand grows past the cap for deep |\u0394level|
  float band = clamp(rawBand, 0.0, BANDS - 1.0); // downstream bf/colour/levelFade unchanged
