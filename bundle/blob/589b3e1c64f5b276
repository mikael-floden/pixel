  }
}
:root[data-theme="light"] {
  --bg: #f6f0e6; --surface: #fdf9f3; --surface-2: #eee6da; --ink: #23211d;
  --muted: #736d63; --border: #e1dacd; --border-strong: #cdc5b6;
  --accent: #d97757; --accent-soft: #fbded4; --accent-ink: #b15005;
