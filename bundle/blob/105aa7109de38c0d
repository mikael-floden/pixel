     left as a trap for whoever next reads it as live. */
  :root.ml-kb-up .ml-chatlog{bottom:calc(var(--ml-inputlift) + 56px)}
  /* \u2500\u2500 compact fits (icons stay at their authored 1x grid at every size) \u2500\u2500 */
  @media (max-width:480px){
    .ml-btnrow{gap:6px}
    .ml-plate-btn{padding:6px 8px;font-size:12px}
  }
  @media (max-height:640px){
    .ml-dials{gap:10px}
    .ml-tabrow{padding:8px 14px 8px}
    .ml-tab{height:48px}
    .ml-subtabs{padding:6px 14px}
    .ml-subtab{height:28px}
    .ml-page{gap:8px;padding:8px 14px calc(8px + var(--ml-safe-bottom, 0px))}
    .ml-plate-btn{min-height:36px}
    .ml-set{gap:10px}
    .ml-amb-list{gap:6px}
    .ml-slots{gap:8px}
    .ml-chat-log{font-size:12.5px}
