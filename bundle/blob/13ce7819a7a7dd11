    font:600 14px/1.3 var(--sans);
    touch-action:manipulation;-webkit-tap-highlight-color:transparent}
  .ml-ddhead:hover{background:var(--surface-2)}
  .ml-ddhead.press{transform:translateY(1px);background:var(--surface-2)}
