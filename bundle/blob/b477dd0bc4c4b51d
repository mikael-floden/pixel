@media (prefers-color-scheme: dark) {
  :root {
    --bg: #262624; --surface: #30302e; --surface-2: #3a3937; --ink: #f0eee7;
    --muted: #a6a195; --border: #43423e; --border-strong: #55534d;
    --accent: #d97757; --accent-soft: #4a352d; --accent-ink: #e6a27f;
