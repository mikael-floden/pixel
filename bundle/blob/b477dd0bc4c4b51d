float mHash(vec2 i) {
  float a = mod(i.x * 113.0 + i.y * 271.0, 971.0);
  a = mod(a * a + 113.0, 971.0);
  a = mod(a * a + i.x, 971.0);
  a = mod(a * a + i.y, 971.0);
  return a / 971.0;
