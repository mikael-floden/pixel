{
  "format": "pixel-composer-assignments@1",
  "_comment": "What the composer's engine ACTUALLY plays for each event the Game Master assigned in the wiki (EVENT_ASSIGNMENTS in composer/engine/api.ts, generated by scripts/build-assignments.mjs). An assignment OUTRANKS EVENT_FOLEY and bindings.json, so this file — not those — is the truth for any event listed here. `sound` is a catalog id or composer/<set>, optionally naming ONE recording as composer/<set>/<take>, composer/<set>#<take>, or a separate `take` field. Each event maps to a LIST: several assigned sounds ROTATE round-robin on that event, each keeping its own pitch/volume/jitter. A one-sound event is a list of one.",
  "events": {
    "item.drop": [
      {
        "sound": "composer/dirt",
        "pitch": 1.35,
        "volume_db": -8,
        "max_random_pitch_semis": 0.4
      }
    ],
    "ui.press": [
      {
        "sound": "composer/ui_click_bead"
      }
    ],
    "ui.release": [
      {
        "sound": "composer/ui_click_latch"
      }
    ],
    "combat.punch": [
      {
        "sound": "composer/punch",
        "pitch": 0.9,
        "max_random_pitch_semis": 0.2
      }
    ],
    "combat.kick": [
      {
        "sound": "hit_hurt"
      }
    ],
    "player.die@default_girl": [
      {
        "sound": "composer/die_voice",
        "take": "die_voice__take06"
      }
    ],
    "combat.cross_on": [
      {
        "sound": "composer/cross_on_peat",
        "take": "cross_on_peat__take01",
        "volume_db": -6
      }
    ],
    "combat.cross_off": [
      {
        "sound": "composer/monster_die_twigs",
        "take": "monster_die_twigs__take01",
        "pitch": 1.85
      }
    ],
    "item.pickup": [
      {
        "sound": "composer/kick_earthmound",
        "take": "kick_earthmound__take01"
      }
    ],
    "combat.hit_taken": [
      {
        "sound": "composer/kick_bamboo",
        "take": "kick_bamboo__take01"
      }
    ],
    "combat.monster_die": [
      {
        "sound": "composer/mon_ice_poring_attack",
        "take": "mon_ice_poring_attack__take01"
      }
    ],
    "progress.level_up": [
      {
        "sound": "composer/level_up_harp",
        "take": "level_up_harp__take01"
      }
    ],
    "player.water_enter": [
      {
        "sound": "composer/cross_rise_water",
        "take": "cross_rise_water__take01"
      },
      {
        "sound": "composer/mon_water_poring_attack",
        "take": "mon_water_poring_attack__take01"
      }
    ],
    "weather.thunder": [
      {
