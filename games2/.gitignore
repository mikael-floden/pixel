# Node / build
node_modules/
dist/
*.tsbuildinfo

# Generated assets (rebuilt by npm run manifest)
client/public/characters.json
client/public/tile-bases.json
client/public/worlds.json

# Throwaway headless-probe scripts (session scratch; never ship)
# One-off probes at the games2 root, the same convention as scripts/_tmp-*:
# throwaway measurement files (mine and subagents') that must never be
# committed. Anchored to this directory so nothing under client/ or server/ is
# swept up by it.
/_*.ts
/_*.mjs
/_*.json
scripts/_tmp-*.mjs
scripts/_tmp-*.mts
scripts/_tmp-*.py
scripts/_tmp-*.png
scripts/_tmp-*.log
scripts/_tmp-*.json
scripts/_tmp-*/
scripts/_wf-*.mjs

# Persistence + env / logs
.data/
**/.data/
.env
*.log

# OS / editor
.DS_Store
*.swp
client/public/shipset.json

# Boot-timing instrument output (verify-boottime.mjs), one JSON line per run
.boottime.json
