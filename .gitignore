# Secrets — never commit
.env

# Python
__pycache__/
*.pyc
.venv/
venv/

# elevation per-run re-roll counter (transient; lives on disk during a run)
tiles2/elevation_state.json
maps2/config/tiles2_analysis.json
scenery/.stop

# tiles 3.0 prompt bake-off output — experiment artefacts, not shipped art
tiles/probes/

# tiles 3.0 generated sheets — curated in the wiki, winners promoted out of here
tiles/matrix/
.claude/settings.local.json

# Agent worktrees — a subagent running in isolation gets a throwaway checkout
# here. They are temporary clones of this same repo and must never be committed.
.claude/worktrees/

# Agent scratch under games2/server/test. games2/.gitignore already ignores
# `scripts/_*` by the same underscore convention; this is the other place a
# probe gets written, and the rule lives HERE rather than there because
# games2/** is the deploy's path filter — ignoring a scratch file must not
# restart his world.
games2/server/test/_*
